# Copy to secret.yaml (gitignored), fill in, then apply it on its own.
# (Named .example so `kubectl apply -f k8s/agent/` skips this template.)
#   kubectl apply -f k8s/agent/secret.yaml
# Injected into agent pods via envFrom (see agent/README.md).
apiVersion: v1
kind: Secret
metadata:
  name: agent-secrets
  namespace: agent
type: Opaque
stringData:
  # Fine-grained PAT: this repo only, Contents read/write (to push the fix
  # branch) + Pull requests read/write. Protect `main` so it can't be pushed.
  GITHUB_TOKEN: "github_pat_..."
  ANTHROPIC_API_KEY: ""
  # Separate key from the app's, so agent runs can't eat the app's quota
  GEMINI_API_KEY: ""
  # "true" = clone, fix, test, print the diff, but no push and no PR.
  # Start here; set "false" once a drill's diff looks sane.
  AGENT_DRY_RUN: "true"
